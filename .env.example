# Copy this file to .env before starting the stack:
# cp .env.example .env

# Container images
POSTGRES_IMAGE=postgres:17-alpine
KAFKA_IMAGE=apache/kafka:latest

# Patient database
PATIENT_DB_NAME=patient-service-db
PATIENT_DB_USER=admin_user
PATIENT_DB_PASSWORD=change-me
PATIENT_DB_HOST_PORT=5432

# Authentication database
AUTH_DB_NAME=auth-service-db
AUTH_DB_USER=admin_user
AUTH_DB_PASSWORD=change-me
AUTH_DB_HOST_PORT=5433

# Kafka
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:29093
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_LISTENERS=PLAINTEXT://kafka:29092,CONTROLLER://kafka:29093,PLAINTEXT_HOST://0.0.0.0:9092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_HOST_PORT=9092

# Service configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_SQL_INIT_MODE=always
BILLING_SERVICE_ADDRESS=billing-service
BILLING_SERVICE_GRPC_PORT=9001
AUTH_SERVICE_ROUTE_URL=http://auth-service:4005
PATIENT_SERVICE_ROUTE_URL=http://patient-service:4000

# Replace this development-only value with a Base64-encoded secret of at least 32 bytes.
JWT_SECRET=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

# Host ports
PATIENT_SERVICE_HOST_PORT=4000
BILLING_SERVICE_HOST_PORT=4001
BILLING_GRPC_HOST_PORT=9001
ANALYTICS_SERVICE_HOST_PORT=4002
AUTH_SERVICE_HOST_PORT=4005
API_GATEWAY_HOST_PORT=4004
